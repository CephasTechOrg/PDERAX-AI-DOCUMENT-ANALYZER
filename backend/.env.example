# PDERAX AI Document Analyzer - Environment Configuration Example
# Copy this file to .env and fill in your actual values

# DeepSeek AI API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# Database (Postgres)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/pderax

# AI Service Settings (seconds)
AI_REQUEST_TIMEOUT=60

# File Upload Settings (MB)
MAX_UPLOAD_SIZE_MB=50

# Application Settings
ENVIRONMENT=development

# JWT Settings
JWT_SECRET=change_me
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=7
SESSION_SECRET=change_me_session

# Email Verification Settings
EMAIL_CODE_SECRET=change_me_too
EMAIL_VERIFY_TTL_MINUTES=10
EMAIL_VERIFY_MAX_ATTEMPTS=5
EMAIL_VERIFY_RESEND_COOLDOWN_SECONDS=60

# SendGrid Settings
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=your_verified_sender@domain.com

# Google OAuth Settings
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URL=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5500
