"""
Analytics Service
Provides lightweight user analytics based on currently available models.
"""

from datetime import datetime, timedelta
from typing import Any, Dict, List
from uuid import UUID

from sqlalchemy import desc, func
from sqlalchemy.orm import Session

from models.db_models import (
    AnalysisResult,
    ChatMessage,
    ChatSession,
    FlashcardSet,
    QuizSet,
)


class AnalyticsService:
    """Service for generating dashboard analytics."""

    @staticmethod
    def get_user_stats(user_id: UUID, db: Session) -> Dict[str, Any]:
        week_ago = datetime.utcnow() - timedelta(days=7)

        total_documents = (
            db.query(func.count(AnalysisResult.id))
            .filter(AnalysisResult.user_id == user_id)
            .scalar()
            or 0
        )
        total_flashcard_sets = (
            db.query(func.count(FlashcardSet.id))
            .filter(FlashcardSet.user_id == user_id)
            .scalar()
            or 0
        )
        total_quizzes = (
            db.query(func.count(QuizSet.id))
            .filter(QuizSet.user_id == user_id)
            .scalar()
            or 0
        )

        documents_this_week = (
            db.query(func.count(AnalysisResult.id))
            .filter(
                AnalysisResult.user_id == user_id,
                AnalysisResult.created_at >= week_ago,
            )
            .scalar()
            or 0
        )
        quizzes_this_week = (
            db.query(func.count(QuizSet.id))
            .filter(QuizSet.user_id == user_id, QuizSet.created_at >= week_ago)
            .scalar()
            or 0
        )

        total_messages = (
            db.query(func.count(ChatMessage.id))
            .join(ChatSession, ChatSession.id == ChatMessage.session_id)
            .filter(ChatSession.user_id == user_id)
            .scalar()
            or 0
        )

        # Approximation: 2 minutes per message for now
        total_study_time = total_messages * 2
        current_streak = AnalyticsService._calculate_streak(user_id, db)

        return {
            "total_documents": total_documents,
            "total_flashcard_sets": total_flashcard_sets,
            "total_quizzes": total_quizzes,
            "total_study_time": total_study_time,
            "average_quiz_score": 0.0,
            "current_streak": current_streak,
            "documents_this_week": documents_this_week,
            "quiz_attempts_this_week": quizzes_this_week,
        }

    @staticmethod
    def get_activity_feed(user_id: UUID, db: Session, limit: int = 20) -> List[Dict[str, Any]]:
        activities: List[Dict[str, Any]] = []

        recent_docs = (
            db.query(AnalysisResult)
            .filter(AnalysisResult.user_id == user_id)
            .order_by(desc(AnalysisResult.created_at))
            .limit(limit)
            .all()
        )
        for doc in recent_docs:
            activities.append(
                {
                    "type": "document_uploaded",
                    "description": f"Uploaded document: {doc.filename}",
                    "timestamp": doc.created_at,
                    "icon": "📄",
                }
            )

        recent_flashcards = (
            db.query(FlashcardSet)
            .filter(FlashcardSet.user_id == user_id)
            .order_by(desc(FlashcardSet.created_at))
            .limit(limit)
            .all()
        )
        for fs in recent_flashcards:
            activities.append(
                {
                    "type": "flashcards_created",
                    "description": f"Created flashcard set: {fs.title or 'Untitled set'}",
                    "timestamp": fs.created_at,
                    "icon": "🗂️",
                }
            )

        recent_quizzes = (
            db.query(QuizSet)
            .filter(QuizSet.user_id == user_id)
            .order_by(desc(QuizSet.created_at))
            .limit(limit)
            .all()
        )
        for quiz in recent_quizzes:
            activities.append(
                {
                    "type": "quiz_created",
                    "description": f"Created quiz: {quiz.title or 'Untitled quiz'}",
                    "timestamp": quiz.created_at,
                    "icon": "📝",
                }
            )

        recent_chats = (
            db.query(ChatSession)
            .filter(ChatSession.user_id == user_id)
            .order_by(desc(ChatSession.created_at))
            .limit(limit)
            .all()
        )
        for chat in recent_chats:
            activities.append(
                {
                    "type": "chat_session",
                    "description": f"Chat session: {chat.title or 'New chat'}",
                    "timestamp": chat.created_at,
                    "icon": "💬",
                }
            )

        activities.sort(key=lambda x: x["timestamp"] or datetime.min, reverse=True)
        activities = activities[:limit]

        for activity in activities:
            if activity["timestamp"]:
                activity["timestamp"] = activity["timestamp"].isoformat()
            else:
                activity["timestamp"] = datetime.utcnow().isoformat()

        return activities

    @staticmethod
    def get_quiz_performance(user_id: UUID, db: Session, days: int = 30) -> List[Dict[str, Any]]:
        date_from = datetime.utcnow() - timedelta(days=days)

        quizzes = (
            db.query(QuizSet)
            .filter(QuizSet.user_id == user_id, QuizSet.created_at >= date_from)
            .order_by(QuizSet.created_at.asc())
            .all()
        )

        # No quiz-attempt scores table in current schema; return timeline with placeholder score 0.
        return [
            {
                "date": quiz.created_at.strftime("%Y-%m-%d"),
                "score": 0.0,
                "attempts": 1,
            }
            for quiz in quizzes
            if quiz.created_at
        ]

    @staticmethod
    def get_study_time(user_id: UUID, db: Session, days: int = 7) -> List[Dict[str, Any]]:
        date_from = datetime.utcnow() - timedelta(days=days)

        daily_counts = (
            db.query(func.date(ChatMessage.created_at), func.count(ChatMessage.id))
            .join(ChatSession, ChatSession.id == ChatMessage.session_id)
            .filter(ChatSession.user_id == user_id, ChatMessage.created_at >= date_from)
            .group_by(func.date(ChatMessage.created_at))
            .all()
        )

        daily_map = {
            str(row[0]): int(row[1]) * 2  # 2 minutes per message
            for row in daily_counts
            if row[0] is not None
        }

        results: List[Dict[str, Any]] = []
        current = datetime.utcnow().date() - timedelta(days=days)
        end = datetime.utcnow().date()

        while current <= end:
            key = current.strftime("%Y-%m-%d")
            minutes = daily_map.get(key, 0)
            results.append({"date": key, "minutes": minutes, "hours": round(minutes / 60, 2)})
            current += timedelta(days=1)

        return results

    @staticmethod
    def get_subject_breakdown(user_id: UUID, db: Session) -> List[Dict[str, Any]]:
        docs = db.query(AnalysisResult).filter(AnalysisResult.user_id == user_id).all()
        subjects: Dict[str, int] = {}

        for doc in docs:
            filename = (doc.filename or "").strip()
            if not filename:
                subject = "Other"
            else:
                base = filename.split(".")[0]
                subject = base.split("_")[0] if "_" in base else base.split("-")[0]
                subject = subject.strip() or "Other"

            subjects[subject] = subjects.get(subject, 0) + 1

        breakdown = [{"subject": k, "count": v} for k, v in subjects.items()]
        breakdown.sort(key=lambda x: x["count"], reverse=True)
        return breakdown

    @staticmethod
    def _calculate_streak(user_id: UUID, db: Session) -> int:
        # Build activity dates from any of the available user activity sources.
        dates = set()

        for created_at, in db.query(AnalysisResult.created_at).filter(AnalysisResult.user_id == user_id).all():
            if created_at:
                dates.add(created_at.date())

        for created_at, in db.query(FlashcardSet.created_at).filter(FlashcardSet.user_id == user_id).all():
            if created_at:
                dates.add(created_at.date())

        for created_at, in db.query(QuizSet.created_at).filter(QuizSet.user_id == user_id).all():
            if created_at:
                dates.add(created_at.date())

        for created_at, in (
            db.query(ChatMessage.created_at)
            .join(ChatSession, ChatSession.id == ChatMessage.session_id)
            .filter(ChatSession.user_id == user_id)
            .all()
        ):
            if created_at:
                dates.add(created_at.date())

        if not dates:
            return 0

        streak = 0
        day = datetime.utcnow().date()
        while day in dates:
            streak += 1
            day -= timedelta(days=1)

        return streak
